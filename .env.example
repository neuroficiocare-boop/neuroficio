# Set to the verified primary production domain before deploying.
NEXT_PUBLIC_SITE_URL=https://www.neuroficio.com

# Care portal: server-only configuration. Never prefix these with NEXT_PUBLIC_.
# Apply supabase/migrations/202611180001_care_portal.sql before enabling.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional: needed only to send patient invitations from the clinical workspace.
SUPABASE_SERVICE_ROLE_KEY=
